# app connects as the NON-superuser role so RLS is enforced
DATABASE_URL=postgresql://techdeva_app:techdeva@db:5432/techdeva
REDIS_URL=redis://redis:6379/0

# --- Live Hermes bot (Agent 07) ---
# Leave HERMES_URL unset for the dev stub. Set it to your bot's base URL to go live.
# HERMES_URL=http://your-vps-or-desktop:8090
# HERMES_REPLY_PATH=/reply
# HERMES_API_KEY=change-me
# HERMES_TIMEOUT=8
# HERMES_RETRIES=2

# --- OAuth (client account connections) ---
# Register a Meta App at developers.facebook.com → Settings → Basic
# META_APP_ID=your-app-id
# META_APP_SECRET=your-app-secret

# Register an OAuth client at console.cloud.google.com → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_SECRET=your-secret

# Public base URL of this API (used as the OAuth redirect origin)
# OAUTH_REDIRECT_BASE=https://api.techdeva.net

# --- Evidence File Storage ---
# STORAGE_BACKEND=local
# STORAGE_DIR=uploads
# MAX_UPLOAD_SIZE_BYTES=10485760

# --- Complaint Multimodal Vision AI ---
# Provider options: gemini (default), openai, anthropic, none
# VISION_PROVIDER=gemini
# VISION_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# --- WhatsApp Inbound Media Intake ---
# Inbound messages with media are posted to /complaints/whatsapp/intake
# Media files from WhatsApp Cloud API or Twilio bridge are downloaded and stored safely
# WHATSAPP_ACCESS_TOKEN=your-whatsapp-system-user-token
# WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
